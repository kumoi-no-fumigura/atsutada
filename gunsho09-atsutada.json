 "poems": [
  {
   "seq": "1",
   "text": "あふことをいさほに出なん篠薄忍ひはつへき物ならなくに",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "心にもあらてありふる年月のけふまてはなとつみてけるかな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "忍ひにもいかてかとはぬ濡衣を名にのみたちてやまんとやする",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "名に立るあまの濡衣くやしきをほさてはやまん物ならなくに",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "しほりたるあまの濡衣同し名を思ひかへさてきるよしもかな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "五月雨のよゝと鳴つる郭公袖のひるまもなきそかなしき",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "雲井にてくもゐにみゆるかさゝきの橋をわたると夢にみし哉",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "うちつけに思ひいつとや故〓のしのふ草にてすれるんけり",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "君なくてたつ朝霧は藤衣いけさへきるそかなしかりける",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "たひとをくわかるゝ人を思ふには心の色そあらはれにける",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "我ひとつたくふるかせをやそしまの松の嵐にあふきくらへよ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "けふそへにくれさらめやはと思へともたへぬは人の心んけり",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "みわの山かひなかりけり我宿の入江の松はきりやしてまし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "白露のいそきおきつるあさかほをみつとも人に夢にかたるな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "あさかほを朝ことにみる物ならは君より外に誰にかはいはん",
   "kana": "",
   "speaker": "敦忠卿集",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "朝な〓〓をきつむ霜のあさからて心とけたるいはねてしかな",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "二葉よりたのみし物をゝみなへし人の垣ねにおひにけるかな",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "人しれす思ふ心はとしをへてなにのかひなくなりぬへき哉",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "うき〓とのしけさまされる夏山の下行水の音もかよはす",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "世中にまたしら雲の山の端にかゝるやつらき心なるらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "むつこともまたいひいてゝ別にし人のかたみはあつまえけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "したにのみなかれわたるは冬河のこほれる水と我となりけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "心から人やりならぬ水なれは流れわたらんこともことはり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "かけにのみ殘れる雪の消はてぬさきにも人のあひみてしかな",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "光みぬかけにならへる雪なれはあひみむからに消てまさらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "露なから野への花をはおらねともたえす袂をしほる比かな",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "露にたにおほせそせましかく計りてる日にぬるゝ袖も有よを",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "さりともと思ふ心にはかられて世にもけふまていける命か",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "賴むにも命のかゝる物ならは千とせもかくてあらんとを思へ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "いつしかとおもふ心のなき人やとまらぬ春をわひしとは思ふ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "野分して白波たゝむ時たにもすくさす君にあひみてしかな",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "松山もこゆといふなる白浪のたゝんつきとはかけすもあら南",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "しひてのみ我身をふれはひとつともおとらぬ物は涙んけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "せきあへぬ淚なれともわれを君けふは心のふるぼまされり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "ひとへたにきるはわひしき藤衣この〓ををさへかさねてそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "きてうしと思ふかきりそ藤衣かさねて色はおもはさりけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "世と共にはれぬ涙にさはりなはよそにのみふる身とや成なん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "世中をわふるわかみはひとつにていかてこゝらの物思ふらむ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "たれかわか身を二つにて物は思ふ幾ら計をこゝらといふらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "今はとて春のわかれに鶯のふるすみけるをくやしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "我のみは夏のなかめはせさりけりおほ空さへや物を思ふらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "物思ひなくてながむるおほ空のうちのころと聞かひのなさ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "いつとなくしつ心なき我戀のさみたれにしもみたれそむらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "古のことかたらひし時鳥いつれのさとに長ゐしぬらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "なからへてへにけるさとは時鳥道のほとたにおほえさりけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "五月雨はすきぬとおもふ時鳥おほ世中をなきつゝやへん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
